<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- IMAGE -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/destination_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/onboard1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- GRADIENT -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/scrim_gradient"
            app:layout_constraintBottom_toBottomOf="@id/destination_image"
            app:layout_constraintEnd_toEndOf="@id/destination_image"
            app:layout_constraintStart_toStartOf="@id/destination_image"
            app:layout_constraintTop_toTopOf="@id/destination_image" />

        <!-- TEXT OVERLAY -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="@id/destination_image"
            app:layout_constraintEnd_toEndOf="@id/destination_image"
            app:layout_constraintStart_toStartOf="@id/destination_image">

            <TextView
                android:id="@+id/destination_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sf_ui_display_semibold"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Name of Destination"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/ivFav"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/destination_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/location"
                android:drawablePadding="4dp"
                android:drawableTint="@android:color/white"
                android:text="Place, Kuningan"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                app:layout_constraintEnd_toStartOf="@id/ivFav"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/destination_title" />

            <ImageView
                android:id="@+id/ivFav"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_rectangle"
                android:backgroundTint="#40FFFFFF"
                android:padding="6dp"
                android:src="@drawable/heart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@android:color/white" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
